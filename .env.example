# Required: the bot's token
TELEGRAM_BOT_TOKEN=

# Optional: comma-separated Telegram user IDs allowed to use the bot (empty = everyone)
ALLOWED_USERS=

# For Instagram downloads: Netscape-format cookies.txt (also helps with age-gated YouTube)
COOKIES_FILE=

# Only for files over 50 MB, on a single device (see INSTALL.md): address of a local Bot API server
# TELEGRAM_API_BASE=http://localhost:8081

# Optional but strongly recommended for Reddit image/gallery posts (anonymous access is blocked on many IPs).
# Create a free "script" app at https://www.reddit.com/prefs/apps and paste its id (under the app name) and secret.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: comma-separated chat/group IDs the bot works in (send /id in the group to get it). Groups are negative numbers.
ALLOWED_CHATS=

# Optional: name shown by /host (defaults to the computer's name)
# HOST_NAME=alice-pi

# Optional: set to 1 when several devices run this bot with the same token (see HOSTING.md); only one is active at a time
# SHARED_HOSTING=1

# yt-dlp updates itself at every start and once a day (the bot restarts itself when idle after an update).
# AUTO_UPDATE_YTDLP=0     turn automatic updates off
# YTDLP_UPDATE_HOURS=24   how often to check while running (0 = only at start)

# The bot also fetches its own new versions from GitHub every few hours and restarts itself when idle.
# AUTO_UPDATE_CODE=0      turn that off (do this to run only code you have checked yourself)
# CODE_UPDATE_HOURS=6     how often to check
# CODE_REPO=etrntyy/IGXYTDL-for-friends   where the updates come from, change it if you run your own copy

# How many times the same link's MP3 is sent to one chat (default 2)
# MP3_LIMIT=2

# How many hours back a link that didn't get downloaded is retried (default 24, 0 = off)
# CATCHUP_HOURS=24
